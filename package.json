{
  "name": "ai-pair-navigator",
  "displayName": "NaviCom",
  "description": "NaviCom is a VS Code extension for AI-assisted coding guidance and learning support.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "private": true,
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onView:aiPairNavigator.sidebar",
    "onCommand:aiPairNavigator.openView",
    "onCommand:aiPairNavigator.connectCopilot",
    "onCommand:aiPairNavigator.askForGuidance",
    "onCommand:aiPairNavigator.askSelection",
    "onCommand:aiPairNavigator.runEvalLive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiPairNavigator.openView",
        "title": "NaviCom: Open View"
      },
      {
        "command": "aiPairNavigator.connectCopilot",
        "title": "NaviCom: Connect Copilot"
      },
      {
        "command": "aiPairNavigator.askForGuidance",
        "title": "NaviCom: Ask For Guidance"
      },
      {
        "command": "aiPairNavigator.askSelection",
        "title": "NaviCom: この箇所を相談",
        "icon": {
          "light": "media/activity-icon.svg",
          "dark": "media/activity-icon.svg"
        }
      },
      {
        "command": "aiPairNavigator.runEvalLive",
        "title": "NaviCom: Run Prompt Evals (Live)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiPairNavigator.runEvalLive",
          "when": "naviCom.devMode"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiPairNavigator",
          "title": "NaviCom",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "aiPairNavigator": [
        {
          "type": "webview",
          "id": "aiPairNavigator.sidebar",
          "name": "NaviCom",
          "icon": "media/activity-icon.svg",
          "visibility": "visible"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run compile:ext && npm run typecheck:webview && npm run build:webview",
    "compile:ext": "tsc -p ./",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "build:webview": "node scripts/clean-webview-output.mjs && esbuild src/views/webview/index.tsx --bundle --outdir=out/webview --entry-names=main --chunk-names=chunks/[name]-[hash] --format=esm --splitting --platform=browser --target=es2020 --tsconfig=tsconfig.webview.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-out/test/FeedbackSummaryPolicy.test.js .test-out/test/SerialTaskQueue.test.js .test-out/test/LmStudioClient.test.js .test-out/test/OrcaRouterClient.test.js .test-out/test/OrcaRouterCredentialStore.test.js .test-out/test/LmStudioServerProtocol.test.js .test-out/test/WebviewMessages.test.js .test-out/test/GuidanceInput.test.js .test-out/test/NavigationCoordinator.test.js",
    "eval": "npm run compile:ext && node out/eval/run-static.js",
    "watch": "tsc -watch -p ./",
    "watch:webview": "esbuild src/views/webview/index.tsx --bundle --outdir=out/webview --entry-names=main --chunk-names=chunks/[name]-[hash] --format=esm --splitting --platform=browser --target=es2020 --tsconfig=tsconfig.webview.json --watch",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.99.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "mermaid": "^11.16.1",
    "sql.js": "^1.14.1"
  }
}
