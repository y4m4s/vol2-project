+/** Local models need an explicit distinction between explaining existing code
+ * and supplying a solution. Depth limits detail, not factual answers. */
+function getLocalQuestionDepthRule(depth: AssistanceDepth): string {
+  return [
+    depth === "high"
+      ? "- High mode: answer the user's question with a compact explanation and relevant conditions."
+      : "- Low mode: answer the user's question briefly with only the necessary explanation.",
+    "For questions about existing code behavior, return values, output, or complexity, give the requested fact first and a short reason grounded in the supplied code. Do not replace an answer with a suggestion to trace or run the code. If evidence is missing, state what cannot be determined and why.",
+    "For implementation or debugging requests, or an explicit request for hints only, give a hint without a completed fix. Explaining the behavior of existing code does not authorize writing replacement code."
+  ].join(" ");
+}
